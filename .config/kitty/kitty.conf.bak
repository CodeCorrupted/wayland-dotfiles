# Fonts
font_family      family='Terminess Nerd Font'
bold_font        auto
italic_font      auto
bold_italic_font auto

# Font size on pts
font_size 12.0

# Enable ligatures only when cursor is not over it
disable_ligatures cursor

# Improvement to underline visualization
modify_font underline_position 4
modify_font underline_thickness 180%

# Drawning default of fonts (thin, normal, thick, very thick)
box_drawing_scale 0.001, 1, 1.5, 2

# Undercurl style
undercurl_style thin-sparse

# Cursor cutomization

# Available options are "beam", "block", "underline", "hollow" and "unchanged"
cursor_shape_unfocused underline

# Set to 0 to never stop, any other value represents seconds of keyboard inactivity
cursor_stop_blinking_after 0

# Aniimation trail for the cursor
cursor_trail 3
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2

# Scrollback

# Size of the history placed on pager
scrollback_pager_history_size 100

# Number of lines scrolled by the mouse wheel
wheel_scroll_multiplier 0

# Mouse

# Style to display URLs
# Available options: none, straight, double, curly, dotted, dashed
url_style curly

# Show the URL of hyperlinks under the mouse
show_hyperlink_targets yes

# Clear the clipboard content when it doesn't reflect the current selection
clear_selection_on_clipboard_loss yes

# List of actions to take when pasting text on the terminal
# Some actions: quote-urls-at-prompt, replace-dangerous-control-codes, replace-newlines
# confirm, confirm-if-large, filter, no-op
paste_actions quote-urls-at-prompt,confirm-if-large

# Remove spaces at the end of lines when copying to clipboard.
# Available Values: smart, always, never
strip_trailing_spaces smart

# Default shape of the mouse pointer when draggin across text
pointer_shape_when_dragging beam

# Performance

# Sync screen updates to the refresh rate of the monitor.
sync_to_monitor no

# Terminal Bell

# Request window attention on bell (flash the taskbar on Linux)
window_alert_on_bell no

# Text to show in the tab that doesn't have focua has a bell.
bell_on_tab none

# Command to run when a bell occurs
command_on_bell none

# Path to a sound file to play as the bell sound (API, WAV, OGA on Linux)
bell_path Navi/watch_out.wav

# Window Layout

# List of layouts enabled coma separated. Value all enables every layout
enabled_layouts Tall,Grid

# Fade the text on inactive windows
# from 0 to 1, 0 fully faded
inactive_text_alpha 0.7

# Hide window decorations. The behavior varies on WM/OS
hide_window_decorations yes

# Logo to display on the corner of the window
# must be a path to the file in PNG/JPEG/WEBP/GIF/TIFF/BMP  format
window_logo_path artix_transparente.png

# Fade of the logo into the background. Values from 0 to 1
window_logo_alpha 0.4

# Percentage of the window size to which the logo should scale (0-100)
window_logo_scale 10

# Tab bar

# Style of tab bar
# Possible values: fade, slant, powerline, custom and hidden
# custom is defined in a tab_bar.py file
tab_bar_style custom

# Minimum amount of tabs to show tab bar
tab_bar_min_tabs 1

# Advanced

# Check update only if its build it from source. 0 means it is disabled
update_check_interval 0

# Show a desktop notification when a long-running command finishes
# Possible values: never, unfocused, invisible, always
# Second argument define the time (in seconds) to consider a command as long running command
# Next, possible values are: notify (to run notification), bell, command
notify_on_cmd_finish invisible

# BEGIN_KITTY_THEME
# Nightfox
include current-theme.conf
# END_KITTY_THEME
