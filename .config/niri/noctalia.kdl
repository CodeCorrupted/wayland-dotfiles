layout {

    focus-ring {
        active-color   "#eb6a61"
        inactive-color "#291514"
        urgent-color   "#e4382b"
    }

    border {
        active-color   "#eb6a61"
        inactive-color "#291514"
        urgent-color   "#e4382b"
    }


    tab-indicator {
        active-color   "#eb6a61"
        inactive-color "#8b170f"
        urgent-color   "#e4382b"
    }

    insert-hint {
        color "#eb6a6180"
    }
}

recent-windows {
    highlight {
        active-color "#eb6a61"
        urgent-color "#e4382b"
    }
}
