layout {

    focus-ring {
        active-color   "#e48467"
        inactive-color "#291914"
        urgent-color   "#c84d29"
    }

    border {
        active-color   "#e48467"
        inactive-color "#291914"
        urgent-color   "#c84d29"
    }


    tab-indicator {
        active-color   "#e48467"
        inactive-color "#852e14"
        urgent-color   "#c84d29"
    }

    insert-hint {
        color "#e4846780"
    }
}

recent-windows {
    highlight {
        active-color "#e48467"
        urgent-color "#c84d29"
    }
}
