#!/bin/sh

music_dir="$HOME/Music"
previewdir="$HOME/.icons"
filename="$(mpc --format "$music_dir"/%file% current)"
previewname="$previewdir/$(mpc --format %album% current | base64).png"

if [[ $(mpc --format %album% current) != '' ]]; then
	[ -e "$previewname" ] || ffmpeg -y -i "$filename" -an -vf scale=128:128 "$previewname" >/dev/null 2>&1
	notify-send -r 27072 "Now Playing" "$(mpc --format '%title% \n%artist% - %album%' current)" --icon="$previewname"
else
	notify-send -r 27072 "Now Playing" "$(mpc --format '%title% \n%artist% - %album%' current)"
fi

